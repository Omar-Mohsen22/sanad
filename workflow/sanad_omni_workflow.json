        "jsCode": "const base = $(\"Merge Chat Outputs\").first().json;\n\n// استخراج المعرفات الموثوقة من سياق الإدخال\nconst userId = base.profile_id || \"user_test_123\";\nconst sessionId = base.session_id || \"session_test_123\";\n\n// تنظيف وتطهير رسالة المستخدم قبل تخزينها لحماية سياق الذاكرة المستقبلي\nlet userMessageClean = base.user_message || \"\";\n\nif (base.input_type === 'image') {\n    // بدلاً من حفظ كود الصورة الطويل أو الـ Base64، بنحفظ دلالة نصية يفهمها الـ LLM لاحقاً\n    userMessageClean = \"[المستخدم أرسل صورة قام السيستم بتحليلها بنجاح]\";\n} else if (base.input_type === 'audio') {\n    // للتأكد أن ما يتم حفظه هو تفريغ الصوت النصي الصافي (STT) وليس مسار الملف\n    userMessageClean = base.user_message || \"[رسالة صوتية مفرغة]\";\n}\n\nreturn [\n  { json: { \n      session_id: sessionId, \n      profile_id: userId, \n      message_type: 'user', \n      content: userMessageClean, \n      route: 'chat',\n      metadata: { \"intent\": base.response_type }\n  } },\n  { json: { \n      session_id: sessionId, \n      profile_id: userId, \n      message_type: 'assistant', \n      content: base.ai_response, \n      route: 'chat',\n      metadata: { \"intent\": base.response_type }\n  } }\n];"
