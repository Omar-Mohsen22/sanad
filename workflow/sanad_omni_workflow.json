      "parameters": {
        "jsCode": "const item = $input.item;\nconst body = item.json.body || {};\n\nlet route = \"chat\";\nif (body.answers && Object.keys(body.answers).length > 0) {\n    route = \"assessment\";\n} else if (body.type === 'recommendation' || body.needs_recommendation === true || (body.user_profile && !body.message && !body.audio && !body.image)) {\n    route = \"recommendation\";\n}\n\nreturn {\n    json: {\n        ...item.json,\n        route: route,\n        body: body,\n        session_id: body.session_id || 'default_session',\n        profile_id: body.profile_id || body.user_profile?.profile_id || 'unknown_user'\n    },\n    binary: item.binary\n};"
