      "position": [
        1904,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet activities = [];\nlet isFallback = false;\n\nif (items.length > 0 && items[0].json && items[0].json.id && !items[0].json.error) {\n    activities = items.map(i => i.json);\n} else {\n    isFallback = true;\n    activities = [\n        { name_ar: \"تمرين التنفس العميق\", description_ar: \"تمرين بسيط للاسترخاء (4-4-6)\", duration_minutes: 5, category: \"حسي\" },\n        { name_ar: \"الاستماع لموسيقى هادئة\", description_ar: \"استمع لموسيقى كلاسيكية في مكان هادئ\", duration_minutes: 15, category: \"سمعي\" },\n        { name_ar: \"تخفيف الإضاءة\", description_ar: \"اجلس في مكان بإضاءة خافتة ومريحة\", duration_minutes: 20, category: \"بصري\" }\n    ];\n}\n\nreturn [{ json: {\n    status: isFallback ? \"fallback\" : \"success\",\n    ui_message: isFallback ? \"تم استخدام الأنشطة البديلة\" : \"تم التخصيص بنجاح\",\n    severity: isFallback ? \"warning\" : \"info\",\n    data: { recommendations: activities, count: activities.length }\n}}];"
      },
