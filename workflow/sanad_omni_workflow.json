    {
      "parameters": {
        "jsCode": "const base = $(\"Auto-Detect Input\").first().json;\nconst text = $input.item.json.text;\nif (!text) {\n    return [{ json: { ...base, content: \"(لم يتم فهم الصوت)\", stt_failed: true } }];\n}\nreturn [{ json: { ...base, content: text } }];"
      },
      "id": "6c04da7c-3207-4e62-992e-adde8f94375f",
      "name": "Format STT Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        208
      ]
