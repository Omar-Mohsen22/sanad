    {
      "parameters": {
        "jsCode": "const data = $('Intent Switch').first().json;\n\n// استخراج النص الأصلي\nconst raw_msg = $input.item.json.output || $input.item.json.text || \"عذراً، أواجه صعوبة في الرد الآن. (النظام قيد التحديث)\";\n\n// التنظيف الشامل للنص\nlet ai_msg = raw_msg;\nif (typeof raw_msg === 'string') {\n  ai_msg = raw_msg\n    .replace(/\\\\n/g, ' ')      // مسح كلمة \\n لو مبعوتة كنص حرفي\n    .replace(/\\n/g, ' ')       // مسح السطر الجديد الفعلي\n    .replace(/\\r/g, ' ')       // مسح أي فواصل سطور تانية\n    .replace(/\\*\\*/g, '')      // مسح نجوم البولد **\n    .replace(/\\s{2,}/g, ' ')   // تحويل أي مسافات كبيرة لـ مسافة واحدة بس\n    .trim();                   // مسح المسافات من أول وآخر الجملة\n}\n\nreturn [{ json: {\n  session_id: data.session_id, \n  profile_id: data.profile_id,\n  input_type: data.input_type,\n  user_message: data.content, \n  ai_response: ai_msg, \n  response_type: \"ai_agent\",\n  has_error: !!$input.item.json.error\n} }];"
      },
