    {
      "parameters": {
        "promptType": "define",
        "text": "=",
        "messages": {
          "messageValues": [
            {
              "message": "=You are \"Sanad\" (سند), a friendly, calm, and respectful support assistant. The user is sharing an image with you.\n\nSafety rules:\n- You are NOT a medical or diagnostic system.\n- Do NOT mention: autism, disorders, diagnosis, anxiety, anxious, depression, therapy, medication, treatment.\n- Do NOT give medical advice. Do NOT shame or judge the user.\n- No roleplay. Do NOT pretend you are physically with the user.\n- If the user mentions self-harm, tell them to get help from a trusted adult or emergency services.\n\nResponse rules (VERY IMPORTANT):\n1. Analyze the image CAREFULLY and describe what you see in detail. Mention the main subjects, the background, and the overall atmosphere or mood of the picture, regardless of what the image contains.\n2. If it is a normal object, hobby, or general picture, start by describing these visual details enthusiastically, then react naturally like a friend sharing an interest. Do NOT force a mental health conversation.\n3. If the image clearly shows sadness, stress, or a quote about feelings, acknowledge the specific details you see gently, then use a warm, supportive tone.\n4. Reply strictly in Egyptian Arabic.\n5. Keep it conversational but detailed (2 to 4 sentences).\n6. End your message with: <END>"
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "image_data"
            },
            {
              "type": "HumanMessagePromptTemplate",
              "message": "=سجل المحادثة السابقة:\n{{ $json.db_history_string }}\n\nسؤال المستخدم الحالي حول الصورة:\n{{ $json.content || \"ماذا ترى في الصورة؟\" }}"
            }
          ]
        },
        "batching": {}
      },
      "id": "a10abc1e-9a1e-4f9d-9762-5c0acb591644",
      "name": "Image Analysis Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1472,
        1024
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $(\"Auto-Detect Input\").first().json;\nconst ai_msg = $input.item.json.output || $input.item.json.text || \"عذراً، لم أتمكن من تحليل الصورة حالياً.\";\nreturn [{ json: { \n    session_id: base.session_id, profile_id: base.profile_id, input_type: \"image\", \n    user_message: base.content, ai_response: ai_msg, response_type: \"image_analysis\" \n} }];"
      },
      "id": "5fa8035d-eff2-45f0-a7c7-bfe2af723620",
      "name": "Format Image Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const historyRows = $input.all().map(item => item.json).filter(j => j.message_type);\nconst sortedHistory = historyRows.reverse();\nlet historyText = \"\";\nsortedHistory.forEach(msg => { historyText += `${msg.message_type === 'user' ? 'User' : 'Sanad'}: ${msg.content}\\n`; });\n\n// Get base data from Text or STT\nlet base;\ntry { base = $(\"Format STT Text\").first().json; } catch(e) {}\nif (!base) base = $(\"Auto-Detect Input\").first().json;\n\nreturn [{ json: { ...base, db_history_string: historyText || \"لا يوجد تاريخ.\" } }];"
      },
      "id": "2f322a71-2150-47da-8c62-2e855c876ec6",
      "name": "Format Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        496
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst msg = (data.content || '').toLowerCase();\nlet intent = \"chatbot\";\n\nconst recs_keywords = ['نشاط', 'أنشطة', 'اقترح', 'توصية', 'نصيحة', 'ألعاب', 'أعمل إيه', 'أهدى', 'استرخاء'];\nconst support_keywords = ['صوت', 'عالي', 'مزعج', 'خايف', 'قلق', 'ملمس', 'يؤلمني', 'مش قادر', 'متوتر', 'حزين'];\n\n// إذا كان نوع المدخل صورة، يتم توجيهه لمسار معالجة الصور فوراً بعد شحن الذاكرة\nif (data.input_type === 'image') {\n    intent = \"image\";\n} else if (recs_keywords.some(k => msg.includes(k))) {\n    intent = \"recs\";\n} else if (support_keywords.some(k => msg.includes(k))) {\n    intent = \"immediate\";\n}\n\nreturn [{ json: { ...data, classified_intent: intent } }];"
      },
