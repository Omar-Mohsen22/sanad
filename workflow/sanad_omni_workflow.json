      "parameters": {
        "jsCode": "const prev = $input.all()[0].json;\n\nif (prev.error && prev.error_code === \"MISSING_ANSWERS\") return [{json: prev}]; // الخطأ من البداية\n\nif (prev.error) { // خطأ في الداتابيز\n    return [{ \n        json: { \n            status: \"partial_success\", \n            severity: \"info\", \n            ui_message: \"تم إنشاء التقييم بنجاح، لكن ستحتاج لإعادته لاحقاً (الخادم مشغول).\", \n            data: prev \n        } \n    }];\n}\n\nreturn [{ \n    json: { \n        status: \"success\", \n        data: { \n            profile_id: prev.profile_id, \n            profile: prev \n        } \n    } \n}];"
