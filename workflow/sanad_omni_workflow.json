        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $input.all()[0].json;\nif (prev.error) return [{json: prev}];\nlet support_needed = [];\nif (prev.social_analysis.level === 'منخفض') support_needed.push('اجتماعي');\nif (prev.sensory_analysis.types.length > 0) support_needed.push('حسي');\nif (support_needed.length === 0) support_needed.push('عام');\n\nreturn [{ json: { ...prev, support_analysis: { types: support_needed, primary: support_needed[0] } } }];"
      },
