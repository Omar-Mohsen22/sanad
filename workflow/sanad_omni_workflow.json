    {
      "parameters": {
        "jsCode": "const data = $input.all()[0].json;\nconst body = data.body || {};\nconst userProfile = body.user_profile || {};\n\n// التعديل هنا: المسار الجديد بيشاور على sensory_types و support_types\nconst sensoryTypes = userProfile.sensory_types?.types || [];\nconst supportTypes = userProfile.support_types?.types || [];\n\nreturn [{ json: { \n  status: \"success\",\n  profile_id: data.profile_id,\n  query_params: { \n      p_sensory_types: sensoryTypes, \n      p_support_types: supportTypes, \n      p_time_of_day: body.context?.time_of_day || null \n  }\n}}];"
      },
      "id": "5694207e-b87e-4ae9-ba50-22d2e42e5a66",
      "name": "Analyze Needs",
      "type": "n8n-nodes-base.code",
