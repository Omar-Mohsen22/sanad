    {
      "parameters": {
        "jsCode": "const base = $input.item.json;\nconst body = base.body || {}; \nconst binary = $input.item.binary || {}; // جلب طبقة الملفات الثنائية المرفوعة\n\n// تأمين جلب المعرفات من مختلف صيغ الـ Request\nconst profileId = body.profile_id || body.user_profile?.profile_id || body.body?.profile_id || \"unknown_user\";\nconst sessionId = body.session_id || body.body?.session_id || \"default_session\";\n\nlet inputType = 'text';\nlet content = body.message || body.text || '';\n\n// تصحيح عبقري: فحص لو الملف جاي كـ Binary File أو مبعوت كنص Base64\nif (body.audio || body.audioData || body.audio_data || binary.audio_data || binary.audio) {\n    inputType = 'audio';\n    // إذا لم يرسل نص مصاحب، نضع دلالة نصية للـ Pipeline\n    content = body.message || body.text || \"رسالة صوتية واردة\";\n} else if (body.image || body.imageData || body.image_url || binary.image_data || binary.image) {\n    inputType = 'image';\n    content = body.message || body.text || \"صورة واردة\";\n}\n\nreturn { \n    json: { \n        session_id: sessionId, \n        profile_id: profileId, \n        input_type: inputType, \n        content: content, \n        original_body: body \n    },\n    binary: $input.item.binary // تمرير الملفات الثنائية للنودز التالية\n};"
      },
