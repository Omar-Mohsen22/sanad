    {
      "parameters": {
        "jsCode": "const inputJson = $input.all()[0].json;\nconst body = inputJson.body || inputJson;\nconst answers = body.answers || {};\nconst language = body.language || 'ar';\n\nif (Object.keys(answers).length === 0) {\n  return [{ json: { error: true, error_code: \"MISSING_ANSWERS\", message_ar: \"الإجابات ناقصة.\" } }];\n}\n\nlet social_score = (parseInt(answers.q1_social_interaction) || 0) + (parseInt(answers.q2_eye_contact) || 0) + (parseInt(answers.q3_conversation) || 0);\nlet social_level = social_score >= 7 ? 'عالي' : social_score >= 4 ? 'متوسط' : 'منخفض';\n\nreturn [{ json: { language: language, answers: answers, profile_id: inputJson.profile_id, social_analysis: { score: social_score, level: social_level } } }];"
      },
      "id": "62dbed54-27cd-4a1f-8c1c-a1ba803def27",
      "name": "Calc Social",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        -96
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $input.all()[0].json;\nif (prev.error) return [{json: prev}];\nconst answers = prev.answers;\nlet sensory_types = [];\nif ((parseInt(answers.q5_auditory) || 0) >= 2) sensory_types.push('سمعية');\nif ((parseInt(answers.q6_visual) || 0) >= 2) sensory_types.push('بصرية');\nif ((parseInt(answers.q7_tactile) || 0) >= 2) sensory_types.push('لمسية');\n\nreturn [{ json: { ...prev, sensory_analysis: { types: sensory_types, severity: sensory_types.length >= 2 ? 'عالية' : 'متوسطة' } } }];"
      },
      "id": "c30f2810-26b0-4de3-bef6-a8d2cefcad9e",
      "name": "Calc Sensory",
      "type": "n8n-nodes-base.code",
